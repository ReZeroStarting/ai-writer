# ============================================================
#  AI Writer 环境变量示例
#  复制成 .env（或直接在终端里 export / set）后填值；
#  .env 与 .env.bat 已被 .gitignore 忽略，不会进仓库。
#  不要把这些真实值写进任何提交里的文件。
# ============================================================

# ---- 必填 ----
# JWT 签名密钥：至少 32 字节随机串。未设置则拒绝启动。
# 生成：openssl rand -base64 32
JWT_SECRET=

# MySQL 口令（用户名默认 root，可用 MYSQL_USER 覆盖）
MYSQL_PASSWORD=

# ---- AI 上游 ----
# anthropic（默认）或 deepseek
AI_PROVIDER=deepseek

# 按 AI_PROVIDER 填对应的 Key；另一个留空
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# 可选：用户自带 Key 的落库加密密钥；不填则用 JWT_SECRET 派生
# AI_KEY_SECRET=

# ---- Redis（会话白名单、限流）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 可选调参 ----
# 接口限流：每分钟每用户（未登录按 IP）请求数；设为 false 可关闭
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60

# AI 调用韧性
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_BREAKER_THRESHOLD=5
AI_BREAKER_OPEN_SECONDS=30

# 设定检索（RAG）
AI_RAG_TOP_K=12
# hashing（本地、离线）或 openai（走 /embeddings，需下面三项）
AI_EMBEDDING_PROVIDER=hashing
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=BAAI/bge-m3

# 成本折算单价（元 / 百万 token），只用于 ai_cost_micros 指标
# 用配置项覆盖：ai.pricing.input-per-million / output-per-million
